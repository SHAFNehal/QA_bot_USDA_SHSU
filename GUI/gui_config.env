# Fine-tuned model (path to your trained weights)
BASE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
PEFT_MODEL_PATH=fine_tuned_weights

# RAG only (path to Chroma database)
RAG_DB_PATH=rag_db
# Optional: RAG model name (leave blank for default)
RAG_MODEL_NAME=

# Hybrid RAG (uses same base + PEFT as fine-tuned, plus RAG db)
HYBRID_RAG_DB_PATH=rag_db
# Optional: small LLM for restate/synthesize (leave blank for default)
HYBRID_SMALL_LLM=

# Optional: generation (used where applicable)
TEMPERATURE=0.7
MAX_NEW_TOKENS=256
RAG_TOP_K=5
